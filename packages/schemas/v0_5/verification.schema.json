{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relayguard:schema:0.5:verification",
  "title": "Verification and Final Approval (SCHEMA.md v0.5 §7-9)",
  "description": "Executable structural contract for Finding, DiffResult, VerificationProposal, Verification, post-verification DelegationAssessment and FinalApproval. Base $defs are copied verbatim from draft.schema.json and shadow_core_result.schema.json.",
  "$ref": "#/$defs/Verification",
  "$defs": {
    "ID": {
      "type": "string",
      "pattern": "[A-Za-z0-9_-]{1,128}"
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]+"
    },
    "TextAllowEmpty": {
      "type": "string",
      "pattern": "[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]*"
    },
    "Hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Decimal": {
      "type": "string",
      "format": "rg-decimal"
    },
    "Date": {
      "type": "string",
      "format": "rg-date"
    },
    "Timestamp": {
      "type": "string",
      "format": "rg-timestamp"
    },
    "CurrencyCode": {
      "type": "string",
      "format": "rg-currency"
    },
    "Confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "format": "rg-confidence"
    },
    "IdSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ID"
      },
      "uniqueItems": true
    },
    "IdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ID"
      }
    },
    "NullableID": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ID"
        }
      ]
    },
    "Modality": {
      "enum": [
        "may",
        "will",
        "must",
        "must_not"
      ]
    },
    "ValueAbsent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "raw_text"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "not_stated",
            "ambiguous"
          ]
        },
        "value": {
          "type": "null"
        },
        "raw_text": {
          "$ref": "#/$defs/TextAllowEmpty"
        }
      }
    },
    "ValueText": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "raw_text"
          ],
          "properties": {
            "status": {
              "const": "explicit"
            },
            "value": {
              "$ref": "#/$defs/Text"
            },
            "raw_text": {
              "$ref": "#/$defs/TextAllowEmpty"
            }
          }
        },
        {
          "$ref": "#/$defs/ValueAbsent"
        }
      ]
    },
    "ValueModality": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "raw_text"
          ],
          "properties": {
            "status": {
              "const": "explicit"
            },
            "value": {
              "$ref": "#/$defs/Modality"
            },
            "raw_text": {
              "$ref": "#/$defs/TextAllowEmpty"
            }
          }
        },
        {
          "$ref": "#/$defs/ValueAbsent"
        }
      ]
    },
    "ValueDecimal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "raw_text"
          ],
          "properties": {
            "status": {
              "const": "explicit"
            },
            "value": {
              "$ref": "#/$defs/Decimal"
            },
            "raw_text": {
              "$ref": "#/$defs/TextAllowEmpty"
            }
          }
        },
        {
          "$ref": "#/$defs/ValueAbsent"
        }
      ]
    },
    "ValueCurrency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "raw_text"
          ],
          "properties": {
            "status": {
              "const": "explicit"
            },
            "value": {
              "$ref": "#/$defs/CurrencyCode"
            },
            "raw_text": {
              "$ref": "#/$defs/TextAllowEmpty"
            }
          }
        },
        {
          "$ref": "#/$defs/ValueAbsent"
        }
      ]
    },
    "ValueDate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "raw_text"
          ],
          "properties": {
            "status": {
              "const": "explicit"
            },
            "value": {
              "$ref": "#/$defs/Date"
            },
            "raw_text": {
              "$ref": "#/$defs/TextAllowEmpty"
            }
          }
        },
        {
          "$ref": "#/$defs/ValueAbsent"
        }
      ]
    },
    "ValueBool": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "raw_text"
          ],
          "properties": {
            "status": {
              "const": "explicit"
            },
            "value": {
              "type": "boolean"
            },
            "raw_text": {
              "$ref": "#/$defs/TextAllowEmpty"
            }
          }
        },
        {
          "$ref": "#/$defs/ValueAbsent"
        }
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_kind",
        "source_id",
        "source_hash",
        "quote",
        "supports",
        "confidence"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/ID"
        },
        "source_kind": {
          "enum": [
            "source_message",
            "reply"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/ID"
        },
        "source_hash": {
          "$ref": "#/$defs/Hash"
        },
        "quote": {
          "$ref": "#/$defs/Text"
        },
        "supports": {
          "$ref": "#/$defs/IdSet"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "TextClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "text": {
          "$ref": "#/$defs/ValueText"
        }
      }
    },
    "ClauseTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "text",
        "modality",
        "condition",
        "scope",
        "monetary_term_ids",
        "deadline_ids",
        "commitment_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "text": {
          "$ref": "#/$defs/ValueText"
        },
        "modality": {
          "$ref": "#/$defs/ValueModality"
        },
        "condition": {
          "$ref": "#/$defs/ValueText"
        },
        "scope": {
          "$ref": "#/$defs/ValueText"
        },
        "monetary_term_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "deadline_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "commitment_ids": {
          "$ref": "#/$defs/IdSet"
        }
      }
    },
    "MonetaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "amount",
        "currency",
        "type",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "amount": {
          "$ref": "#/$defs/ValueDecimal"
        },
        "currency": {
          "$ref": "#/$defs/ValueCurrency"
        },
        "type": {
          "enum": [
            "price",
            "discount",
            "credit",
            "refund",
            "payment",
            "fee",
            "other"
          ]
        },
        "condition": {
          "$ref": "#/$defs/ValueText"
        }
      }
    },
    "DateTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "type",
        "date",
        "timezone"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "type": {
          "enum": [
            "date",
            "deadline"
          ]
        },
        "date": {
          "$ref": "#/$defs/ValueDate"
        },
        "timezone": {
          "$ref": "#/$defs/ValueText"
        }
      }
    },
    "QuantityTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "quantity",
        "unit",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "quantity": {
          "$ref": "#/$defs/ValueDecimal"
        },
        "unit": {
          "$ref": "#/$defs/ValueText"
        },
        "condition": {
          "$ref": "#/$defs/ValueText"
        }
      }
    },
    "RightsLicenseTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "scope",
        "exclusivity",
        "sublicensing",
        "commercial_use",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "scope": {
          "$ref": "#/$defs/ValueText"
        },
        "exclusivity": {
          "$ref": "#/$defs/ValueBool"
        },
        "sublicensing": {
          "$ref": "#/$defs/ValueBool"
        },
        "commercial_use": {
          "$ref": "#/$defs/ValueBool"
        },
        "condition": {
          "$ref": "#/$defs/ValueText"
        }
      }
    },
    "Commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "actor",
        "action",
        "object",
        "modality",
        "condition",
        "scope",
        "deadline_id",
        "monetary_term_ids",
        "authorization_state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "actor": {
          "enum": [
            "user",
            "counterparty",
            "third_party",
            "unknown"
          ]
        },
        "action": {
          "$ref": "#/$defs/ValueText"
        },
        "object": {
          "$ref": "#/$defs/ValueText"
        },
        "modality": {
          "$ref": "#/$defs/ValueModality"
        },
        "condition": {
          "$ref": "#/$defs/ValueText"
        },
        "scope": {
          "$ref": "#/$defs/ValueText"
        },
        "deadline_id": {
          "$ref": "#/$defs/NullableID"
        },
        "monetary_term_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "authorization_state": {
          "enum": [
            "requested",
            "approved",
            "rejected",
            "unanswered",
            "not_approved"
          ]
        }
      }
    },
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "text",
        "required_answer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "text": {
          "$ref": "#/$defs/ValueText"
        },
        "required_answer": {
          "type": "boolean"
        }
      }
    },
    "Emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "type",
        "intensity",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "type": {
          "enum": [
            "anger",
            "distrust",
            "cancellation_intent",
            "public_complaint",
            "other"
          ]
        },
        "intensity": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "target": {
          "$ref": "#/$defs/ValueText"
        }
      }
    },
    "LegalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "claim_type",
        "requires_human_review"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "claim_type": {
          "$ref": "#/$defs/ValueText"
        },
        "requires_human_review": {
          "const": true
        }
      }
    },
    "Risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ids",
        "type",
        "description",
        "affects_critical",
        "resolved"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "type": {
          "enum": [
            "reputational",
            "contradiction",
            "missing_information",
            "ambiguity",
            "attachment",
            "injection",
            "policy_exception",
            "other"
          ]
        },
        "description": {
          "$ref": "#/$defs/ValueText"
        },
        "affects_critical": {
          "type": "boolean"
        },
        "resolved": {
          "type": "boolean"
        }
      }
    },
    "StructuredState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sender_intent",
        "requests",
        "questions",
        "monetary_terms",
        "dates",
        "quantities",
        "contract_terms",
        "prohibitions",
        "guarantees",
        "refund_terms",
        "cancellation_terms",
        "license_terms",
        "rights",
        "requested_commitments",
        "commitments",
        "personal_data",
        "customer_emotion",
        "legal_claims",
        "reputational_risks",
        "prior_commitment_conflicts",
        "risks",
        "ambiguities",
        "missing_information",
        "attachment_dependencies",
        "prompt_injection_risks",
        "recommended_actions",
        "human_review_required",
        "confidence",
        "evidence"
      ],
      "properties": {
        "sender_intent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextClaim"
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextClaim"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "monetary_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonetaryTerm"
          }
        },
        "dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DateTerm"
          }
        },
        "quantities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuantityTerm"
          }
        },
        "contract_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClauseTerm"
          }
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClauseTerm"
          }
        },
        "guarantees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClauseTerm"
          }
        },
        "refund_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClauseTerm"
          }
        },
        "cancellation_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClauseTerm"
          }
        },
        "license_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RightsLicenseTerm"
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RightsLicenseTerm"
          }
        },
        "requested_commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Commitment"
          }
        },
        "commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Commitment"
          }
        },
        "personal_data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextClaim"
          }
        },
        "customer_emotion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Emotion"
          }
        },
        "legal_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegalClaim"
          }
        },
        "reputational_risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "prior_commitment_conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "attachment_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "prompt_injection_risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Risk"
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextClaim"
          }
        },
        "human_review_required": {
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "source_hash",
        "interpretation_id",
        "interpretation_version",
        "decision_id",
        "decision_version",
        "decision_hash",
        "policy_version"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/ID"
        },
        "source_hash": {
          "$ref": "#/$defs/Hash"
        },
        "interpretation_id": {
          "$ref": "#/$defs/ID"
        },
        "interpretation_version": {
          "$ref": "#/$defs/Version"
        },
        "decision_id": {
          "$ref": "#/$defs/ID"
        },
        "decision_version": {
          "$ref": "#/$defs/Version"
        },
        "decision_hash": {
          "$ref": "#/$defs/Hash"
        },
        "policy_version": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "DraftBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "draft_id",
        "draft_hash"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/Binding"
        },
        "draft_id": {
          "$ref": "#/$defs/ID"
        },
        "draft_hash": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "ReplyExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction_id",
        "binding",
        "state"
      ],
      "properties": {
        "extraction_id": {
          "$ref": "#/$defs/ID"
        },
        "binding": {
          "$ref": "#/$defs/DraftBinding"
        },
        "state": {
          "$ref": "#/$defs/StructuredState"
        }
      }
    },
    "DelegationLevel": {
      "enum": [
        "L0_AUTO",
        "L1_POST_REVIEW",
        "L2_PRE_APPROVAL",
        "L3_STOP"
      ]
    },
    "ReasonCode": {
      "enum": [
        "LEGAL_CLAIM",
        "UNRESOLVED_PROMPT_INJECTION",
        "CRITICAL_MISSING_INFORMATION",
        "ATTACHMENT_REQUIRED_MISSING",
        "CONTRADICTORY_COMMITMENTS",
        "CRITICAL_DIFF",
        "REFUND_OR_CREDIT",
        "CONTRACTUAL_CHANGE",
        "RIGHTS_OR_LICENSE_CHANGE",
        "NEW_GUARANTEE",
        "MATERIAL_MONEY_CHANGE",
        "MATERIAL_DEADLINE_CHANGE",
        "QUANTITY_CHANGE",
        "PERSONAL_DATA_DISCLOSURE",
        "NEW_COMMITMENT",
        "POLICY_EXCEPTION",
        "CUSTOMER_SENSITIVITY",
        "LOW_RISK_INFORMATIONAL",
        "LOW_RISK_POST_REVIEW",
        "UNCLASSIFIED_RISK",
        "ANSWER_REVIEW_REQUIRED",
        "INVALID_INPUT",
        "INCOMPLETE_PIPELINE",
        "STALE_STATE",
        "VERIFIER_BLOCK"
      ]
    },
    "RiskAxis": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "RiskFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact",
        "uncertainty",
        "irreversibility",
        "customer_sensitivity"
      ],
      "properties": {
        "impact": {
          "$ref": "#/$defs/RiskAxis"
        },
        "uncertainty": {
          "$ref": "#/$defs/RiskAxis"
        },
        "irreversibility": {
          "$ref": "#/$defs/RiskAxis"
        },
        "customer_sensitivity": {
          "$ref": "#/$defs/RiskAxis"
        }
      }
    },
    "DelegationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "binding",
        "phase",
        "draft_binding",
        "level",
        "minimum_level",
        "reason_codes",
        "risk_factors",
        "shadow_mode",
        "human_review_required"
      ],
      "properties": {
        "assessment_id": {
          "$ref": "#/$defs/ID"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "phase": {
          "enum": [
            "pre_generation",
            "post_verification"
          ]
        },
        "draft_binding": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/DraftBinding"
            }
          ]
        },
        "level": {
          "$ref": "#/$defs/DelegationLevel"
        },
        "minimum_level": {
          "$ref": "#/$defs/DelegationLevel"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "uniqueItems": true
        },
        "risk_factors": {
          "$ref": "#/$defs/RiskFactors"
        },
        "shadow_mode": {
          "const": true
        },
        "human_review_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "pre_generation"
              }
            }
          },
          "then": {
            "properties": {
              "draft_binding": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "draft_binding": {
                "$ref": "#/$defs/DraftBinding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "L0_AUTO"
              }
            }
          },
          "then": {
            "properties": {
              "human_review_required": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "human_review_required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "NullableHash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Hash"
        }
      ]
    },
    "FindingType": {
      "enum": [
        "amount_changed",
        "currency_changed",
        "date_changed",
        "quantity_changed",
        "right_changed",
        "license_changed",
        "guarantee_added",
        "refund_added",
        "commitment_added",
        "prohibition_removed",
        "required_answer_missing",
        "condition_removed",
        "ambiguity_resolved_without_authority",
        "attachment_dependency",
        "prompt_injection_risk",
        "unsupported_claim",
        "state_mismatch",
        "customer_emotion_missed",
        "legal_claim_detected",
        "delegation_level_too_low"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "type",
        "severity",
        "blocking",
        "origin",
        "expected_claim_ids",
        "actual_claim_ids",
        "evidence_ids",
        "explanation_ja"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/ID"
        },
        "type": {
          "$ref": "#/$defs/FindingType"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "deterministic_diff",
            "verifier",
            "domain"
          ]
        },
        "expected_claim_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "actual_claim_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "explanation_ja": {
          "$ref": "#/$defs/Text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "severity": {
                "const": "critical"
              }
            }
          },
          "then": {
            "properties": {
              "blocking": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "DiffResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "findings",
        "checked_fields",
        "complete"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/DraftBinding"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "checked_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "uniqueItems": true
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "LevelProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason_codes"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/DelegationLevel"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "uniqueItems": true
        }
      }
    },
    "VerificationProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "overall_status",
        "findings",
        "unanswered_items",
        "new_commitments",
        "uncertain_items",
        "delegation_reassessment",
        "human_review_required"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/DraftBinding"
        },
        "overall_status": {
          "enum": [
            "matched",
            "minor_differences",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "unanswered_items": {
          "$ref": "#/$defs/IdSet"
        },
        "new_commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Commitment"
          }
        },
        "uncertain_items": {
          "$ref": "#/$defs/IdSet"
        },
        "delegation_reassessment": {
          "$ref": "#/$defs/LevelProposal"
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    },
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_id",
        "binding",
        "extraction_id",
        "verifier_execution_id",
        "diff",
        "proposal",
        "policy_status",
        "policy_version"
      ],
      "properties": {
        "verification_id": {
          "$ref": "#/$defs/ID"
        },
        "binding": {
          "$ref": "#/$defs/DraftBinding"
        },
        "extraction_id": {
          "$ref": "#/$defs/ID"
        },
        "verifier_execution_id": {
          "$ref": "#/$defs/ID"
        },
        "diff": {
          "$ref": "#/$defs/DiffResult"
        },
        "proposal": {
          "$ref": "#/$defs/VerificationProposal"
        },
        "policy_status": {
          "enum": [
            "BLOCK",
            "SAFE_CANDIDATE"
          ]
        },
        "policy_version": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "FinalApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "binding",
        "verification_id",
        "assessment_id",
        "approved_by",
        "approved_at",
        "approval_hash"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/ID"
        },
        "binding": {
          "$ref": "#/$defs/DraftBinding"
        },
        "verification_id": {
          "$ref": "#/$defs/ID"
        },
        "assessment_id": {
          "$ref": "#/$defs/ID"
        },
        "approved_by": {
          "$ref": "#/$defs/ID"
        },
        "approved_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "approval_hash": {
          "$ref": "#/$defs/Hash"
        }
      }
    }
  }
}
