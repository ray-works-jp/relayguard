    "DecisionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "source_claim_id",
        "decision",
        "replacement",
        "provenance"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/ID"
        },
        "source_claim_id": {
          "$ref": "#/$defs/ID"
        },
        "decision": {
          "enum": [
            "approve",
            "modify",
            "unknown",
            "do_not_answer"
          ]
        },
        "replacement": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ClaimReplacement"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/UserProvenance"
        }
      },
      "if": {
        "properties": {
          "decision": {
            "const": "modify"
          }
        }
      },
      "then": {
        "properties": {
          "replacement": {
            "$ref": "#/$defs/ClaimReplacement"
          }
        }
      },
      "else": {
        "properties": {
          "replacement": {
            "type": "null"
          }
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "version",
        "source_interpretation_id",
        "source_interpretation_version",
        "source_hash",
        "items",
        "question_answers",
        "approved_commitments",
        "explicitly_unanswered",
        "human_notes",
        "approved_by",
        "approved_at",
        "decision_hash"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/ID"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "source_interpretation_id": {
          "$ref": "#/$defs/ID"
        },
        "source_interpretation_version": {
          "$ref": "#/$defs/Version"
        },
        "source_hash": {
          "$ref": "#/$defs/Hash"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DecisionItem"
          }
        },
        "question_answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionAnswer"
          }
        },
        "approved_commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Commitment"
          }
        },
        "explicitly_unanswered": {
          "$ref": "#/$defs/IdSet"
        },
        "human_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "approved_by": {
          "$ref": "#/$defs/ID"
        },
        "approved_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "decision_hash": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "ShadowCoreInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "source_message",
        "interpretation",
        "approved_decision",
        "policy_version"
      ],
      "properties": {
        "schema_version": {
          "const": "0.5"
        },
        "case_id": {
          "$ref": "#/$defs/ID"
        },
        "source_message": {
          "$ref": "#/$defs/SourceMessage"
        },
        "interpretation": {
          "$ref": "#/$defs/Interpretation"
        },
        "approved_decision": {
          "$ref": "#/$defs/Decision"
        },
        "policy_version": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "QuestionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "answer_text",
        "basis",
        "evidence_ids",
        "related_claim_ids",
        "provenance"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/ID"
        },
        "answer_text": {
          "$ref": "#/$defs/Text"
        },
        "basis": {
          "enum": [
            "user_assertion",
            "source_evidence"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "related_claim_ids": {
          "$ref": "#/$defs/IdSet"
        },
        "provenance": {
          "$ref": "#/$defs/UserProvenance"
        }
      },
      "if": {
        "properties": {
          "basis": {
            "const": "user_assertion"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  }
}
